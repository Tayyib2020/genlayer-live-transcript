NODE_ENV=development
SERVER_PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require

# GenLayer verification. Never expose this value to the client.
GENLAYER_PRIVATE_KEY=
GENLAYER_TRANSCRIPT_VERIFIER_ADDRESS=0x4DEfE1bbE75C59FcD2264EaCb75096f3CD659f5B
GENLAYER_NETWORK=testnet-bradbury
GENLAYER_TRANSCRIPT_VERIFIER_SUPPORTS_ATTEMPTS=1

# Phase 4 speech-to-text. The provider key is server-side only and is never sent to the client.
TRANSCRIPTION_PROVIDER=deepgram
TRANSCRIPTION_API_KEY=
# Phase 6 off-chain summary generation. Keep provider keys server-side only.
SUMMARY_PROVIDER=openai
SUMMARY_API_KEY=
SUMMARY_MODEL=gpt-5-mini
# Alternative provider using the same variables:
# SUMMARY_PROVIDER=gemini
# SUMMARY_API_KEY=
# SUMMARY_MODEL=gemini-3.6-flash
